class Solution {
public:
    int maxNumberOfFamilies(int n, vector<vector<int>>& VseAt) {
        int ans=n*2;
        sort(VseAt.begin(),VseAt.end());
        for(int i=0;i<VseAt.size();i++){
            int curr=VseAt[i][0];
            int flag25=1;
            int flag47=1;
            int flag69=1;

            while(i<VseAt.size()&&VseAt[i][0]==curr){
                if(VseAt[i][1]>=2&&VseAt[i][1]<=5){
                    flag25=0;
                    if(VseAt[i][1]>=4&&VseAt[i][1]<=5){
                        flag47=0;
                    }
                }else if(VseAt[i][1]>=6&&VseAt[i][1]<=9){
                    flag69=0;
                    if(VseAt[i][1]>=6&&VseAt[i][1]<=7){
                        flag47=0;
                    }
                }
                i++;

            }
           if(flag69==0&&flag25==0&&flag47==0){
            ans--;
            ans--;
           }else if(flag69==0||flag47==0||flag25==0){
            ans--;
           }
           i--;
           
        }
        return ans;
    }
};
